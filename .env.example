# CMS allowed domains for CSRF protection
# Comma-separated list of domains where the CMS frontend is hosted.
# For Cloudflare FQDN requests, it's recommended to append a dot at the end of domains.
# E.g., my-domain.com,my-domain.com.
ALLOWED_DOMAINS=my-domain.com,my-domain.com.

# Database credentials
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=jvcms_db

# JWT Secret (Must be a secure base64 string, at least 32 bytes)
# Generate one using: openssl rand -base64 32
# Or in PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }) -as [byte[]])
JWT_SECRET=


# Security token required to create the first admin user (optional, but recommended in production)
CMS_SETUP_TOKEN=my-secret-setup-token-123
